{
  "name": "dflight-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc && cp src/data/airports.json lib/data/airports.json",
    "test": "tsc && tsx --test --test-concurrency=1 test/unit/*.test.ts test/data/*.test.ts",
    "test:emulator": "npm run build && export JAVA_HOME=/opt/homebrew/opt/openjdk@21 PATH=/opt/homebrew/opt/openjdk@21/bin:$PATH && node scripts/run-emulator-tests.cjs"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "firebase-tools": "^15.33.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
